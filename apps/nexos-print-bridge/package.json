{
  "name": "@nexos/print-bridge",
  "version": "1.0.0",
  "description": "Serviço local para Windows de ponte entre NexOS ERP e impressoras",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsup src/server.ts --format cjs --clean",
    "pkg": "pkg . --targets node18-win-x64 --out-path dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "electron": "^43.3.0",
    "fastify": "^5.11.3",
    "pdf-to-printer": "^5.6.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "jest": "^30.4.2",
    "pkg": "^5.8.1",
    "ts-jest": "^29.4.12",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "targets": [
      "node18-win-x64"
    ]
  }
}
